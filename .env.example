VITE_ATHENA_MODE=demo
VITE_ATHENA_BACKEND_URL=
VITE_ATHENA_CONTROL_URL=
VITE_ATHENA_PROJECT_DIR=
VITE_ATHENA_TOKEN=

# Optional Vite proxy targets. By default the dev server reads
# ~/.context-workspace/backend.json and ~/.context-workspace/electron-control.json.
ATHENA_BACKEND_TARGET=
ATHENA_CONTROL_TARGET=

# Optional: the Athena that runs Jarvis, if it isn't found on its own (loopback
# or Tailscale http:// only), and its access token when it needs one.
ATHENA_JARVIS_TARGET=
ATHENA_JARVIS_TOKEN=
